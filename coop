#!/usr/bin/env bash
# AI Autonomic Synthesis Platform v41.0 (The Architect)
# Fully autonomous AI CLI, bulletproofed
set -euo pipefail
IFS=$'\n\t'

# === 2. ENVIRONMENT & PATHS ===
AI_HOME="${AI_HOME:-$HOME/.local_ai}"
PROJECTS_DIR="${PROJECTS_DIR:-$AI_HOME}" # Base directory for tasks
LOG_DIR="$AI_HOME/logs"
TMP_DIR="$AI_HOME/tmp"
SWAP_DIR="$AI_HOME/swap"
CORE_DB="$AI_HOME/agent_core.db"
TASK_DB="$AI_HOME/ai_task_manager.db"
LOG_FILE="$LOG_DIR/system.log"
HMAC_SECRET_KEY="$AI_HOME/secret.key"

mkdir -p "$LOG_DIR" "$TMP_DIR" "$SWAP_DIR"

# === COLORS & ICONS ===
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; PURPLE='\033[0;35m'; CYAN='\033[0;36m'; NC='\033[0m'
ICON_INFO="ℹ️"; ICON_WARN="⚠️"; ICON_ERROR="❌"; ICON_SUCCESS="✅"; ICON_TASK="📝"; ICON_TRADE="💰"

log_to_file(){ echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"; }
log(){ local lvl="$1"; local msg="$2"; echo -e "${lvl}${msg}${NC}"; log_to_file "$msg"; }
log_info(){ log "$BLUE$ICON_INFO " "$1"; }
log_warn(){ log "$YELLOW$ICON_WARN " "$1"; }
log_error(){ log "$RED$ICON_ERROR " "$1"; }
log_success(){ log "$GREEN$ICON_SUCCESS " "$1"; }
log_trade(){ log "$CYAN$ICON_TRADE " "$1"; }
log_task(){ log "$PURPLE$ICON_TASK " "$1"; }

# === SECURITY ===
if [[ ! -f "$HMAC_SECRET_KEY" ]]; then
    openssl rand -hex 32 > "$HMAC_SECRET_KEY"
    chmod 600 "$HMAC_SECRET_KEY"
    log_success "Generated HMAC secret key"
fi
calc_hmac(){ echo -n "${1:-}" | openssl dgst -sha256 -hmac "$(cat "$HMAC_SECRET_KEY")" | awk '{print $2}'; }

# === HASH FUNCTIONS ===
hash_string(){ echo -n "${1:-}" | sha256sum | awk '{print $1}'; }
hash_string_salt(){ echo -n "${1:-}${2:-}" | sha256sum | awk '{print $1}'; }
hash_file(){ local file="${1:-}" algo="${2:-sha256}"; [[ -f "$file" ]] || return 1; case $algo in sha256) sha256sum "$file" | awk '{print $1}';; sha512) sha512sum "$file" | awk '{print $1}';; md5) md5sum "$file" | awk '{print $1}';; esac }
hash_dir(){ local dir="${1:-}"; [[ -d "$dir" ]] || return 1; find "$dir" -type f -exec sha256sum {} + | sort | sha256sum | awk '{print $1}'; }

# === MIME PROCESSING ===
mime_type(){ file --mime-type -b "${1:-}"; }
process_file(){ local f="${1:-}"; [[ -f "$f" ]] || return; local m; m=$(mime_type "$f"); case $m in
    text/*) log_info "Text file: $f -> hashing"; hash_file "$f";;
    image/*) log_info "Image file detected: $f";;
    application/zip) log_info "Archive file detected: $f";;
    *) log_warn "Unknown MIME type: $f";;
esac }

# === DATABASE INIT ===
init_db(){
sqlite3 "$TASK_DB" <<SQL
CREATE TABLE IF NOT EXISTS projects(hash TEXT PRIMARY KEY, path TEXT, ts DATETIME DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS file_hashes(project_hash TEXT, file_path TEXT, file_hash TEXT, rehashed INTEGER DEFAULT 0, PRIMARY KEY(project_hash,file_path));
CREATE TABLE IF NOT EXISTS events(id INTEGER PRIMARY KEY AUTOINCREMENT, ts DATETIME DEFAULT CURRENT_TIMESTAMP, type TEXT, data TEXT);
SQL

sqlite3 "$CORE_DB" <<SQL
CREATE TABLE IF NOT EXISTS memories(id INTEGER PRIMARY KEY, prompt_hash TEXT, prompt TEXT, response_ref TEXT);
CREATE TABLE IF NOT EXISTS tool_logs(id INTEGER PRIMARY KEY, task_id TEXT, tool_name TEXT, args TEXT, result TEXT);
SQL
log_success "Databases initialized"
}

sqlite_escape(){ echo "${1:-}" | sed "s/'/''/g"; }

# === AI MODELS & PARAMETERS ===
MESSENGER_MODEL="core"
PLANNER_MODEL="loop"
EXECUTOR_MODEL="2244-1"
MAX_AGENT_LOOPS=12
MAX_RAM_BYTES=2097152 # 2MB threshold for swap

# === AI WORKER STREAMING ===
run_worker_streaming(){
    local model="${1:-}" prompt="${2:-}"
    local full=""
    local payload
    payload=$(jq -nc --arg m "$model" --arg p "$prompt" '{model:$m,prompt:$p,stream:true}')
    while IFS= read -r line; do
        if jq -e . >/dev/null 2>&1 <<<"$line"; then
            local token
            token=$(echo "$line" | jq -r '.response // empty')
            [[ -n "$token" ]] && { printf "%s" "$token"; full+="$token"; }
        fi
    done < <(curl -s --max-time 300 -X POST http://localhost:11434/api/generate -d "$payload" || true)
    printf "\n"
    echo "$full"
}

# === TOOLS ===
tool_ingest(){ local repo="${1:-}"; [[ -d "$repo" ]] || { log_error "Repo not found"; return 1; }; local h; h=$(hash_string "$repo"); sqlite3 "$TASK_DB" "INSERT OR IGNORE INTO projects(hash,path) VALUES('$(sqlite_escape "$h")','$(sqlite_escape "$repo")');"; find "$repo" -type f | while read -r f; do sqlite3 "$TASK_DB" "INSERT OR REPLACE INTO file_hashes(project_hash,file_path,file_hash,rehashed) VALUES('$(sqlite_escape "$h")','$(sqlite_escape "$f")','$(hash_file "$f")',0)"; done; log_success "Ingested $repo -> $h"; echo "$h"; }

tool_rehash(){ local h="${1:-}"; local base; base=$(sqlite3 "$TASK_DB" "SELECT path FROM projects WHERE hash='$(sqlite_escape "$h")' LIMIT 1"); [[ -d "$base" ]] || { log_error "No project path for hash $h"; return 1; }; find "$base" -type f | while read -r f; do local newh oldh; newh=$(hash_file "$f"); oldh=$(sqlite3 "$TASK_DB" "SELECT file_hash FROM file_hashes WHERE project_hash='$(sqlite_escape "$h")' AND file_path='$(sqlite_escape "$f")'"); [[ "$newh" != "$oldh" ]] && sqlite3 "$TASK_DB" "INSERT OR REPLACE INTO file_hashes(project_hash,file_path,file_hash,rehashed) VALUES('$(sqlite_escape "$h")','$(sqlite_escape "$f")','$newh',1)"; done; log_success "Rehash completed for $h"; }

tool_qbit(){ local args="${*:-}"; sqlite3 "$TASK_DB" "INSERT INTO events(type,data) VALUES('qbit','$(sqlite_escape "$args")')"; log_task "QBit task logged: $args"; }

tool_btc(){ local action="${1:-analyze}"; case $action in
    analyze) log_trade "Analyzing BTC/USD market..."; run_worker_streaming "$EXECUTOR_MODEL" "BTC/USD technical analysis";;
    buy|sell) log_trade "Simulated BTC $action executed.";;
    *) log_warn "Unknown BTC action: $action";;
esac }

tool_webkit(){ log_info "Building WebKit (may take hours)..."; mkdir -p "$TMP_DIR/webkit"; cd "$TMP_DIR/webkit"; git clone https://github.com/WebKit/WebKit.git . || true; ./Tools/Scripts/build-webkit || true; log_success "WebKit build complete."; }

# === AGI LOOP ===
run_agi(){
    local prompt="${*:-}" task_id project_dir conversation
    task_id=$(hash_string "$prompt$(date +%s%N)" | cut -c1-16)
    project_dir="$PROJECTS_DIR/task-$task_id"; mkdir -p "$project_dir"
    log_success "Project workspace: $project_dir (Task ID: $task_id)"
    conversation="$prompt"
    for ((i=1;i<=MAX_AGENT_LOOPS;i++)); do
        log_info "AGI Loop $i/$MAX_AGENT_LOOPS"
        local messenger_output planner_output final_decision
        messenger_output=$(run_worker_streaming "$MESSENGER_MODEL" "$conversation")
        planner_output=$(run_worker_streaming "$PLANNER_MODEL" "$messenger_output")
        final_decision=$(run_worker_streaming "$EXECUTOR_MODEL" "$planner_output")
        conversation="$final_decision"
        [[ "$final_decision" == *"[FINAL_ANSWER]"* ]] && break
    done
    local final_answer; final_answer=$(echo "$conversation" | sed 's/\[FINAL_ANSWER\]//')
    echo -e "\n${GREEN}--- Final Result ---${NC}\n$final_answer"
}

# === MAIN DISPATCHER ===
main(){
    init_db
    local cmd="${1:-}"; shift || true
    case "$cmd" in
        ingest) tool_ingest "$@" ;;
        rehash) tool_rehash "$@" ;;
        qbit) tool_qbit "$@" ;;
        btc) tool_btc "$@" ;;
        webkit) tool_webkit ;;
        "") run_agi "$@" ;;
        *) run_agi "$cmd $*" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
