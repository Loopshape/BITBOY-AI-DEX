#!/usr/bin/env python3
import os
import time
import uuid
import subprocess
from termcolor import colored

from ollama_hybrid import OllamaClient, NetResolver  # import our hybrid backend classes


class HybridAgent:
    def __init__(self):
        self.project_id = uuid.uuid4().hex[:16]
        self.workspace = f"/home/loop/ai_projects/{self.project_id}"
        os.makedirs(self.workspace, exist_ok=True)
        self.client = OllamaClient()
        self.resolver = NetResolver()

    def log(self, msg, color="white"):
        ts = time.strftime("[%H:%M:%S]")
        print(f"{ts} {colored(msg, color)}")

    def run(self):
        self.log("Activating Agent in Mode: agent", "magenta")
        self.log(f"Created project workspace: {self.workspace}", "green")

        # Iterate agent steps
        for i in range(1, 4):  # demo: 3 iterations
            self.log(f"Agent Iteration {i}/3", "magenta")
            self.log("Thinking...", "yellow")
            time.sleep(1)

            if i == 1:
                host = "openai.com"
                ip = self.resolver.dns_to_ip(host)
                rev = self.resolver.ip_to_dns(ip)
                reply = self.client.run("core", f"Validate {host} -> {ip} -> {rev}")
                print("CORE:", reply)

            elif i == 2:
                opp = "Hybrid IPv6 NAT AI edge opportunities"
                reply = self.client.run("2244-1", f"Opportunity analysis: {opp}")
                print("2244-1:", reply)

            elif i == 3:
                # Optional: spawn Node frontend for demo
                try:
                    out = subprocess.check_output(
                        ["node", "ollama-hybrid-cli.js", "opportunity", "AI + Termux integration"],
                        stderr=subprocess.STDOUT
                    ).decode()
                    print("NODE FRONTEND OUTPUT:\n", out)
                except Exception as e:
                    print("⚠️ Node CLI not available:", e)

        self.log("Agent run complete.", "cyan")


if __name__ == "__main__":
    agent = HybridAgent()
    agent.run()
